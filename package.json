{
  "name": "@dreher-media/dm-js-lib",
  "version": "1.9.3",
  "description": "Centralized JavaScript library for Dreher.Media websites with CDN delivery",
  "type": "module",
  "main": "dist/dm-js-lib.min.js",
  "files": [
    "dist/dm-js-lib.min.js",
    "dist/standalone",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"*.{js,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"*.{js,cjs,json,md}\"",
    "verify": "npm run format:check && npm run typecheck",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,cjs,json,md}": "prettier --write"
  },
  "keywords": [
    "cdn",
    "javascript",
    "typescript"
  ],
  "author": "Tobias Laufersweiler <tobias@dreher-media.de>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.2.5",
    "rollup": "^4.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
